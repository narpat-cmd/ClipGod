# ClipGod Environment Variables
# Copy this file to .env and fill in your values

# App Settings
APP_NAME=ClipGod
APP_VERSION=1.0.0
DEBUG=true

# Database
# For local development, SQLite is used by default
# For production (Render), use PostgreSQL connection string
DATABASE_URL=sqlite:///./clipgod.db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Whisper Model (tiny, base, small, medium, large)
WHISPER_MODEL=base

# File Storage Paths
UPLOAD_DIR=./uploads
CLIPS_DIR=./clips
TEMP_DIR=./temp

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Optional: Redis for Celery (if using background workers)
# REDIS_URL=redis://localhost:6379/0